# Copy to `.env` for local development:  cp .env.example .env
# `.env` is gitignored; this file is the committed, non-secret template.
#
# Everything here is prefixed VITE_, which means Vite inlines the literal value
# into the JavaScript bundle at build time. Anything in this file is therefore
# PUBLIC once deployed. Never add a service-role key, a database password, or
# any other true secret to a VITE_ variable — put those in Supabase Edge
# Function secrets instead, where they stay server-side.


# --- Required: Supabase -------------------------------------------------------

# Your project's API URL, from Supabase Dashboard > Project Settings > API.
# Format: https://<project-ref>.supabase.co
# The CSP in public/_headers allows https://*.supabase.co and wss://*.supabase.co,
# so a stock Supabase URL works as-is. A custom domain or self-hosted instance
# must also be added to `connect-src` there or every request will be blocked.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# The "anon" / publishable key from the same settings page.
#
# THIS KEY IS MEANT TO BE PUBLIC. It ships in the browser bundle by design and
# is visible to anyone who opens devtools. It grants no privileges on its own —
# it only identifies the project. Row Level Security policies on each table are
# what actually authorise reads and writes, evaluated per authenticated user.
#
# Do not "fix" this by moving it to a server, proxying it, or obfuscating it:
# the client cannot talk to Supabase without it, and hiding it buys nothing.
# The key that must never appear here is the `service_role` key, which bypasses
# RLS entirely. If a service_role key ever lands in a VITE_ variable, rotate it.
VITE_SUPABASE_ANON_KEY=your-anon-key-here


# --- Optional: feature flags --------------------------------------------------

# Labels the running build. Set automatically per-environment in CI/Pages;
# defaults to "development" locally.
# VITE_ENVIRONMENT=development

# Legacy StudyPartner sync integration. Leave unset unless you are actively
# using it — note that api.studypartner.app is NOT in the CSP `connect-src`
# allowlist in public/_headers, so enabling this also requires adding that
# origin there.
# VITE_ENABLE_STUDYPARTNER_SYNC=false
# VITE_STUDYPARTNER_API_URL=
# VITE_STUDYPARTNER_API_KEY=
